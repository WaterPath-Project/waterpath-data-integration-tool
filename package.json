{
  "name": "waterpath-data-integration-tool",
  "version": "0.2.0",
  "description": "WaterPath Data Integration Tool: the GloWPa input-data wizard as an embeddable React component",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:worker": "node scripts/build-worker.mjs",
    "predev": "npm run build:worker",
    "dev": "vite --config vite.config.ghpages.ts",
    "prebuild": "npm run build:worker",
    "build": "tsc -b && vite build",
    "prebuild:embed": "npm run build:worker",
    "build:embed": "tsc -b && vite build --config vite.config.function.ts",
    "prebuild:ghpages": "npm run build:worker",
    "build:ghpages": "tsc -b && vite build --config vite.config.ghpages.ts",
    "prepare": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview --config vite.config.ghpages.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.2",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "@rive-app/react-canvas": "^4.19.1",
    "@tanstack/react-query": "^5.75.1",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "country-flag-icons": "^1.5.16",
    "georaster": "^1.6.0",
    "georaster-layer-for-leaflet": "^4.1.2",
    "i18next": "^23.16.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "maplibre-gl": "^6.11.2",
    "next-themes": "^0.4.6",
    "proj4": "^2.11.0",
    "react-i18next": "^15.1.1",
    "react-leaflet": "^4.2.1",
    "react-router": "^7.5.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.8.7",
    "@types/proj4": "^2.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.3.4",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^5.1.2"
  }
}
